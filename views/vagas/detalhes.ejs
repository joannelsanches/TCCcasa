<%- include('../partials/cabecalho', { titulo: vaga.titulo }) %>

<section class="section">
    <div class="container split">

        <article class="card">

            <span class="badge <%= vaga.status.toLowerCase() %>">
                <%= vaga.status.replaceAll('_', ' ') %>
            </span>

            <h1>
                <%= vaga.titulo %>
            </h1>

            <p>
                <strong><%= vaga.empresa?.nomeFantasia %></strong>
                ·
                <%= vaga.localizacao %>
            </p>

            <h3>Sobre a vaga</h3>

            <p>
                <%= vaga.descricao %>
            </p>

            <h3>Requisitos</h3>

            <p>
                <%= vaga.requisitos %>
            </p>

            <h3>Cursos aceitos</h3>

            <div class="job-meta">
                <% vaga.cursosCompativeis.forEach(c => { %>

                    <span class="tag">
                        <%= c.nome %>
                    </span>

                <% }) %>
            </div>

        </article>


        <aside class="card">

            <h2>Resumo</h2>

            <div class="details-list">

                <div>
                    <strong>Bolsa</strong>
                    <%= formatarMoeda(vaga.bolsa) %>
                </div>

                <div>
                    <strong>Carga horária</strong>
                    <%= vaga.cargaHoraria %>h/semana
                </div>

                <div>
                    <strong>Área</strong>
                    <%= vaga.areaAtuacao?.nome %>
                </div>

                <div>
                    <strong>Campus</strong>
                    <%= vaga.campus?.nome %>
                </div>

                <div>
                    <strong>Localização</strong>
                    <%= vaga.localizacao %>
                </div>

                <div>
                    <strong>Prazo</strong>
                    <%= formatarData(vaga.prazo) %>
                </div>

            </div>


            <div class="actions">

                <% if (usuarioLogado?.tipo === 'ESTUDANTE' && vaga.status === 'ABERTA') { %>

                    <form
                        method="post"
                        action="/candidaturas/<%= vaga._id %>"
                        style="width:100%"
                    >
                        <button
                            class="btn"
                            style="width:100%"
                        >
                            Candidatar-se
                        </button>
                    </form>

                <% } else if (!usuarioLogado) { %>

                    <a
                        class="btn"
                        href="/login"
                    >
                        Entrar para candidatar-se
                    </a>

                <% } %>

            </div>

        </aside>

    </div>
</section>

<%- include('../partials/rodape') %>