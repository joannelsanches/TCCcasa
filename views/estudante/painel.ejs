<%- include('../partials/cabecalho', { titulo: 'Painel do estudante' }) %>

<section class="section">
    <div class="container">

        <div class="page-header">
            <span class="eyebrow">Área do estudante</span>

            <h1>
                Olá, <%= usuarioLogado.nome %>!
            </h1>

            <p class="muted">
                <%= estudante.curso?.nome %>
                ·
                <%= estudante.campus?.nome %>
            </p>
        </div>

        <div class="metrics">

            <div class="metric">
                <strong><%= candidaturas %></strong>
                <span>candidaturas</span>
            </div>

            <div class="metric">
                <strong><%= termos %></strong>
                <span>termos pendentes</span>
            </div>

            <div class="metric">
                <strong>
                    <%= estudante.curriculo?.caminho ? 'OK' : '—' %>
                </strong>
                <span>currículo</span>
            </div>

        </div>

        <div class="section-heading" style="margin-top:36px">

            <div>
                <h2>Vagas para o seu curso</h2>

                <p class="muted">
                    Oportunidades abertas e compatíveis.
                </p>
            </div>

            <a href="/vagas">
                Buscar mais →
            </a>

        </div>

        <div class="grid">

            <% vagas.forEach(vaga => { %>
                <article class="card job-card">

                    <span class="tag">
                        <%= vaga.areaAtuacao?.nome %>
                    </span>

                    <h3>
                        <%= vaga.titulo %>
                    </h3>

                    <p>
                        <%= vaga.empresa?.nomeFantasia %>
                    </p>

                    <p class="muted">
                        <%= vaga.localizacao %>
                        ·
                        <%= formatarMoeda(vaga.bolsa) %>
                    </p>

                    <div class="actions">
                        <a
                            class="btn btn-secondary"
                            href="/vagas/<%= vaga._id %>"
                        >
                            Ver detalhes
                        </a>
                    </div>

                </article>
            <% }) %>

        </div>

        <% if (!vagas.length) { %>
            <div class="empty">
                Ainda não há vagas compatíveis com o seu curso.
            </div>
        <% } %>

    </div>
</section>

<%- include('../partials/rodape') %>