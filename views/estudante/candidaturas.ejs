<%- include('../partials/cabecalho', { titulo: 'Minhas candidaturas' }) %>

<section class="section">
    <div class="container">

        <div class="page-header">
            <h1>Minhas candidaturas</h1>

            <p class="muted">
                Acompanhe o resultado informado pelas empresas.
            </p>
        </div>

        <div class="table-wrap">
            <table>

                <thead>
                    <tr>
                        <th>Vaga</th>
                        <th>Empresa</th>
                        <th>Data</th>
                        <th>Status</th>
                        <th>Observação</th>
                    </tr>
                </thead>

                <tbody>
                    <% candidaturas.forEach(c => { %>
                        <tr>

                            <td>
                                <a href="/vagas/<%= c.vaga?._id %>">
                                    <%= c.vaga?.titulo || 'Vaga removida' %>
                                </a>
                            </td>

                            <td>
                                <%= c.vaga?.empresa?.nomeFantasia || '—' %>
                            </td>

                            <td>
                                <%= formatarData(c.dataCandidatura) %>
                            </td>

                            <td>
                                <span class="badge <%= c.status.toLowerCase() %>">
                                    <%= c.status.replaceAll('_',' ') %>
                                </span>
                            </td>

                            <td>
                                <%= c.observacaoEmpresa || '—' %>
                            </td>

                        </tr>
                    <% }) %>
                </tbody>

            </table>
        </div>

        <% if (!candidaturas.length) { %>
            <div class="empty">
                Você ainda não se candidatou.
                <a href="/vagas">Conheça as vagas abertas.</a>
            </div>
        <% } %>

    </div>
</section>

<%- include('../partials/rodape') %>